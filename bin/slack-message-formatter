#!/bin/bash

# Purpose: to replace @username with <@11111111> slack profile id

MESSAGE="$@"

if [ "$SLACK_USER_CONF" = "" ]; then
    SLACK_USER_CONF="/etc/slack-user.conf"
fi

if [ ! -f "$SLACK_USER_CONF" ]; then
    echo "$MESSAGE"
    exit
fi

# Walk the message left to right so @bob never matches inside an earlier @bobby
RESULT=""
REMAINING="$MESSAGE"
USERNAME_REGEX="@([A-Za-z0-9_]+)"

while [[ ${REMAINING} =~ ${USERNAME_REGEX} ]]; do
    MATCH=${BASH_REMATCH[0]}
    USERNAME=${BASH_REMATCH[1]}
    PROFILE_ID=$(grep -m 1 "^$USERNAME:" "$SLACK_USER_CONF" | cut -d ':' -f 2)

    RESULT="$RESULT${REMAINING%%"$MATCH"*}"
    if [[ ! -z "$PROFILE_ID" ]]; then
        RESULT="$RESULT<@$PROFILE_ID>"
    else
        RESULT="$RESULT$MATCH"
    fi

    REMAINING=${REMAINING#*"$MATCH"}
done

echo "$RESULT$REMAINING"
